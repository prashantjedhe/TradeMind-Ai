# Docker Compose service URLs. Use localhost URLs only when running
# the backend directly outside Docker.
DATABASE_URL=postgresql+asyncpg://trademind:trademind_secret@db:5432/trademind_db
REDIS_URL=redis://redis:6379/0

# Generate a unique random value for every deployed environment.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_VIRTUAL_BALANCE=1000000.0

# Optional external services. Keep real keys in a local .env file or
# deployment secret manager; never commit them.
# ANTHROPIC_API_KEY=
